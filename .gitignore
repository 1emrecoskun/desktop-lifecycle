# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Build output
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# Test and coverage output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checker and linter caches
.mypy_cache/
.ruff_cache/

# Editors and operating systems
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Local environment files that must never be committed
.env
.env.*
!.env.example
